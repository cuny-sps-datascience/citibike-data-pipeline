{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnFolder",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::cuny-sps-citibike-archive/contributions/${aws:username}/*"
    },
    {
      "Sid": "ReadAllContributions",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cuny-sps-citibike-archive/contributions/*"
    },
    {
      "Sid": "ListAllContributions",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cuny-sps-citibike-archive",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["contributions/", "contributions/*"]
        }
      }
    }
  ]
}
